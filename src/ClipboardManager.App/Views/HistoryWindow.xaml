<Window x:Class="ClipboardManager.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ClipboardManager.App.Converters"
        xmlns:viewModels="clr-namespace:ClipboardManager.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:HistoryViewModel}"
        Title="Clipboard Manager"
        Width="480"
        Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <converters:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmapConverter" />
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Modern ScrollViewer style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="#4E5058" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow container -->
    <Border Margin="10"
            Background="#1E1F22"
            CornerRadius="14"
            BorderBrush="#383A40"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title & Action Bar -->
                <RowDefinition Height="Auto" />
                <!-- Search Input Bar -->
                <RowDefinition Height="Auto" />
                <!-- History Items List -->
                <RowDefinition Height="*" />
                <!-- Footer / Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0"
                    Padding="16,14,14,10"
                    BorderBrush="#2B2D31"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon -->
                        <Border Width="24" Height="24" Background="#3B82F6" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Clipboard History"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F2F3F5"
                                   VerticalAlignment="Center" />
                        <Border Background="#2B2D31" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Foreground="#949BA4" FontSize="11">
                                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                                <Run Text="items" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Clear non-pinned button -->
                        <Button ToolTip="Clear history (keeps pinned)"
                                Command="{Binding ClearNonPinnedCommand}"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6" Padding="6,4">
                                        <TextBlock Text="🧹 Clear" FontSize="11" Foreground="#949BA4" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#2B2D31" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Settings button -->
                        <Button ToolTip="Settings"
                                Command="{Binding OpenSettingsCommand}"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6" Padding="6,4">
                                        <TextBlock Text="⚙️" FontSize="13" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#2B2D31" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Minimize button -->
                        <Button Click="OnMinimizeButtonClick"
                                ToolTip="Minimize"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="—" FontSize="11" Foreground="#949BA4" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#35373C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close button -->
                        <Button Click="OnCloseButtonClick"
                                ToolTip="Close"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="✕" FontSize="12" Foreground="#949BA4" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Search Input Bar -->
            <Border Grid.Row="1" Padding="14,10,14,10">
                <Grid>
                    <Border Background="#2B2D31"
                            CornerRadius="8"
                            BorderBrush="#383A40"
                            BorderThickness="1"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔍" FontSize="12" Foreground="#949BA4" Margin="0,0,8,0" VerticalAlignment="Center" />

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     PreviewKeyDown="OnSearchBoxPreviewKeyDown" />

                            <TextBlock Grid.Column="1"
                                       Text="Type to search history..."
                                       Foreground="#6D6F78"
                                       FontSize="13"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Clear search text button -->
                            <Button Grid.Column="2"
                                    Click="OnClearSearchClick"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="✕" FontSize="10" Foreground="#949BA4" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. History List -->
            <Grid Grid.Row="2" Margin="14,0,14,8">
                <!-- Empty State Message -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,10" />
                    <TextBlock Text="No clipboard history yet"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#80848E"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Items you copy will automatically appear here."
                               FontSize="12"
                               Foreground="#5C5E66"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Items ListBox -->
                <ListBox x:Name="HistoryListBox"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="OnListBoxDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="#2B2D31"
                                                CornerRadius="8"
                                                BorderBrush="#35373C"
                                                BorderThickness="1"
                                                Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#35373C" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4E5058" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#383A40" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B82F6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ClipboardItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Pin Toggle Button -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Content Preview -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Actions & Time -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Pin Button -->
                                <Button Grid.Column="0"
                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        ToolTip="Toggle pin">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Padding="4" Background="Transparent">
                                                <TextBlock Text="★"
                                                           FontSize="15"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#5C5E66" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F59E0B" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Center: Content Preview (Text or Image) -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Text Item Template -->
                                    <StackPanel Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding PreviewText}"
                                                   Foreground="#DBDEE1"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="38"
                                                   LineHeight="18" />
                                    </StackPanel>

                                    <!-- Image Item Template -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border CornerRadius="4"
                                                BorderBrush="#3F4147"
                                                BorderThickness="1"
                                                Background="#1E1F22"
                                                Width="72"
                                                Height="48"
                                                Margin="0,0,10,0">
                                            <Image Source="{Binding ImageData, Converter={StaticResource ByteArrayToBitmapConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Image"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding PreviewText}"
                                                       FontSize="11"
                                                       Foreground="#949BA4"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Right: Timestamp & Delete Button -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CopiedAt, Converter={StaticResource RelativeTimeConverter}}"
                                               FontSize="11"
                                               Foreground="#80848E"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />

                                    <!-- Delete Item Button -->
                                    <Button Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete item"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="delBorder" Background="Transparent" CornerRadius="4" Padding="4">
                                                    <TextBlock Text="🗑" FontSize="11" Foreground="#80848E" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="delBorder" Property="Background" Value="#4E5058" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 4. Footer Bar -->
            <Border Grid.Row="3"
                    Padding="14,8"
                    BorderBrush="#2B2D31"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Foreground="#80848E" FontSize="11" VerticalAlignment="Center">
                        <Run Text="Press" />
                        <Run FontWeight="SemiBold" Text="Enter" />
                        <Run Text="or double-click to paste" />
                    </TextBlock>

                    <TextBlock Grid.Column="1"
                               Foreground="#80848E"
                               FontSize="11"
                               Text="Esc to close"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
