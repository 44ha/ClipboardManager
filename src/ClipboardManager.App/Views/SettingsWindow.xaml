<Window x:Class="ClipboardManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ClipboardManager.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
        Title="Settings — Clipboard Manager"
        Width="480"
        Height="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Common Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#35373C" />
            <Setter Property="Foreground" Value="#DBDEE1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#404249" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#1E1F22"
            CornerRadius="14"
            BorderBrush="#383A40"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="Auto" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
                <!-- Action Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0"
                    Padding="16,14"
                    BorderBrush="#2B2D31"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" Background="#3B82F6" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="⚙️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Settings"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F2F3F5"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="1"
                            Click="OnCloseButtonClick"
                            ToolTip="Close (Esc)"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6" Padding="6,4">
                                    <TextBlock Text="✕" FontSize="12" Foreground="#949BA4" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#35373C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel>
                    <!-- Global Hotkey Card -->
                    <Border Background="#2B2D31" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#35373C" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Global Hotkey" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13" />
                            <TextBlock Text="Press this combination from anywhere to open your clipboard history."
                                       Foreground="#949BA4" FontSize="11" Margin="0,2,0,10" />

                            <Grid>
                                <TextBox Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#1E1F22"
                                         Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF"
                                         BorderBrush="#383A40"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="13"
                                         FontWeight="SemiBold" />
                            </Grid>

                            <!-- Error message banner if hotkey collision occurs -->
                            <Border Background="#450A0A"
                                    BorderBrush="#DC2626"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HotkeyErrorMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HotkeyErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Style.Resources>
                                            <!-- If non-empty string, show -->
                                        </Style.Resources>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding HotkeyErrorMessage}" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="Format: Modifiers + Key (e.g. Ctrl + Shift + V, Alt + Insert, Win + F1)"
                                       Foreground="#6D6F78" FontSize="10" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Max History Size Card -->
                    <Border Background="#2B2D31" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#35373C" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="History Limit" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13" />
                            <TextBlock Text="Maximum number of non-pinned items to preserve in database."
                                       Foreground="#949BA4" FontSize="11" Margin="0,2,0,10" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Slider Minimum="10"
                                        Maximum="1000"
                                        SmallChange="10"
                                        LargeChange="50"
                                        TickFrequency="50"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding MaxHistoryItems, Mode=TwoWay}"
                                        VerticalAlignment="Center" />

                                <Border Grid.Column="1" Background="#1E1F22" CornerRadius="6" Padding="10,4" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding MaxHistoryItems}" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                            </Grid>

                            <TextBlock Text="Oldest non-pinned items are automatically removed when exceeded. Pinned items are never deleted."
                                       Foreground="#6D6F78" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Pause Monitoring Card -->
                    <Border Background="#2B2D31" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#35373C" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Pause Clipboard Monitoring" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="Temporarily stop capturing copied text and images."
                                           Foreground="#949BA4" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMonitoringPaused, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Danger Zone Card -->
                    <Border Background="#2B2D31" CornerRadius="10" Padding="14" BorderBrush="#35373C" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Purge All History" FontWeight="SemiBold" Foreground="#EF4444" FontSize="13" />
                                <TextBlock Text="Permanently deletes all saved clipboard items (including pinned)."
                                           Foreground="#949BA4" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding ClearAllHistoryCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Clear Database"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Status Notification Message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#10B981"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Bottom Actions -->
            <Border Grid.Row="2"
                    Padding="16,12"
                    BorderBrush="#2B2D31"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Button Command="{Binding ResetDefaultsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Reset Defaults"
                            HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="OnCloseButtonClick"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Cancel"
                                Margin="0,0,10,0" />

                        <Button Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Save Changes" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
